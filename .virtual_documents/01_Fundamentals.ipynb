def square(x):
    """Square of x."""
    return x*x

def cube(x):
    """Cube of x."""
    return x*x*x

# create a dictionary of functions
funcs = {
    'square': square,
    'cube': cube,
}

x = 3
print(square(x))
print(cube(x))

for func in sorted(funcs):
    print (func, funcs[func](x))








